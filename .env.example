# MySQL / MariaDB connection for db_mts3_athaullah.
# Replace DB_USER and DB_PASSWORD with credentials from the server.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/db_mts3_athaullah"
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=DB_USER
DATABASE_PASSWORD=DB_PASSWORD
DATABASE_NAME=db_mts3_athaullah

# Admin bootstrap account used once by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-password
ADMIN_SESSION_SECRET=replace-this-with-a-random-secret
